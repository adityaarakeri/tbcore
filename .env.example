# Example environment for working on tbcore. Copy to .env (git-ignored), uncomment
# what you need, and pass it explicitly; tbcore does not load .env files itself:
#
#   cp .env.example .env
#   uv run --env-file .env python examples/codex_sandbox.py
#
# Every line is commented out. Keep unused ones that way: an empty value overrides
# the default instead of falling back to it.
# Keys stay on the host. Give them to sandboxes with inject_headers, never env=.
#
# Labels: REQUIRED = the named feature fails without it.
#         OPTIONAL = has a default (shown) or the feature works without it.

# --- Hosted providers (read by Client) ----------------------------------------
# REQUIRED for Anthropic models such as Client("sonnet"): Client raises TbError.
# ANTHROPIC_API_KEY=
# REQUIRED for OpenAI models such as Client("gpt-4o-mini"), and for the Codex
# example and live smoke below.
# OPENAI_API_KEY=

# --- Local LLMs (Ollama, vLLM, LM Studio, other OpenAI-compatible servers) ------
# No variable here is required: local servers usually need no key. When a key is
# set, it is sent as "Authorization: Bearer <key>".
# Server addresses are NOT environment variables. Put them in a model config file
# (copy tbcore.example.toml to tbcore.toml, then load_model_config("tbcore.toml") and
# Client(name, config=config)); the file names the key variable via api_key_env. Or set
# them in code:
#   make_model_spec("qwen3:8b", provider="ollama")   # default http://localhost:11434
#   make_model_spec("org/model", provider="vllm")    # default http://localhost:8000
#   make_model_spec("m", provider="openai-compat", base_url="http://localhost:1234/v1")
# (provider="openai-compat" requires base_url; the other two have defaults.)
# OPTIONAL, Ollama key, for a server behind auth.
# OLLAMA_API_KEY=
# OPTIONAL, vLLM key, for a server started with --api-key.
# VLLM_API_KEY=
# OPTIONAL, openai-compat key (LM Studio and others).
# OPENAI_COMPAT_API_KEY=

# --- Call accounting ------------------------------------------------------------
# OPTIONAL, where CallLog writes when no path is passed.
# Default: .tbcore/calls.jsonl (directory is created on first write).
# TBCORE_LOG_PATH=.tbcore/calls.jsonl

# --- Console logging (configure_logging) ---------------------------------------------
# OPTIONAL. Color is used on an interactive terminal. NO_COLOR=1 turns it off;
# FORCE_COLOR=1 keeps it when output is piped. NO_COLOR wins if both are set.
# NO_COLOR=1
# FORCE_COLOR=1

# --- Codex sandbox (examples/codex_sandbox.py, tests/test_codex_sandbox.py) -------
# REQUIRED for the example (KeyError without it); the image test skips instead.
# Exact Codex CLI package version (such as 1.2.3) to bake into the image.
# TBCORE_CODEX_VERSION=
# OPTIONAL, model for Codex runs. Default: gpt-6.1-sol
# TBCORE_CODEX_MODEL=gpt-6.1-sol

# --- Paid live smoke (tests/test_live_codex_smoke.py; incurs provider charges) ----
# Skipped unless TBCORE_RUN_LIVE_CODEX=1. Also needs OPENAI_API_KEY and
# TBCORE_CODEX_VERSION above. Run with:
#   uv run --env-file .env pytest -m live tests/test_live_codex_smoke.py -q
# OPTIONAL, opt-in switch. Unset means the test skips.
# TBCORE_RUN_LIVE_CODEX=1
# REQUIRED once opted in (KeyError without it). No default; this is a suggestion.
# TBCORE_LIVE_REPORT=.tbcore/live-codex-report.json
